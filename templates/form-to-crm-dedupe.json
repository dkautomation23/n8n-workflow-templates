{
  "name": "Contact form to CRM with dedupe",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-form",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1f121978-e9dc-4df4-bacf-448a68fd00f6",
      "name": "Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1c2a2f5a-39e5-4a4d-bec0-edce2737682e",
              "name": "email",
              "value": "={{ $json.body.email.toLowerCase().trim() }}",
              "type": "string"
            },
            {
              "id": "56a57424-7d01-488c-9a57-57de79218d78",
              "name": "name",
              "value": "={{ $json.body.name.trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "67ad2084-8167-4b89-b95d-a177ac4ff02e",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.email }}",
        "options": {}
      },
      "id": "d9667def-bfa0-410d-8db3-0d30d5a5e5fb",
      "name": "Seen before?",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.your-crm.example/v1/contacts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"email\": $json.email, \"name\": $json.name } }}",
        "options": {}
      },
      "id": "10eb8bac-65e6-48c0-9c15-1ebf57ac8b5d",
      "name": "Create CRM contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"received\" } }}",
        "options": {}
      },
      "id": "00fd6387-ee52-46f3-9d53-ad09273df76c",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        840,
        300
      ]
    }
  ],
  "connections": {
    "Form Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Seen before?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seen before?": {
      "main": [
        [
          {
            "node": "Create CRM contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create CRM contact": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
