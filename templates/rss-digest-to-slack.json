{
  "name": "Send a daily digest of RSS items to a Slack channel",
  "nodes": [
    {
      "id": "main",
      "name": "Sticky Note main",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -656,
        96
      ],
      "parameters": {
        "content": "## Send a daily digest of RSS items to a Slack channel\n\n### How it works\n\n1. Runs once each morning on a schedule trigger and reads the feed.\n2. Keeps only items published in the last 24 hours, because an RSS feed returns its whole current window on every read rather than just what changed.\n3. Formats each remaining item into a single line.\n4. Merges those lines into one payload with Aggregate, so one message is posted instead of one per item.\n5. Posts the finished digest to your Slack channel.\n\n### Setup steps\n\n- [ ] Put your feed URL in the RSS node.\n- [ ] Create a Slack credential and pick the destination channel in the last node.\n- [ ] Adjust the schedule trigger to the time you want the digest to arrive.\n- [ ] Run it once by hand to check the formatting before enabling it.\n\n### Customization\n\nAdd more RSS nodes and merge them to cover several feeds in one digest. Change the filter window to run weekly instead of daily. Swap the Slack node for Telegram, Discord, or email without touching the rest of the workflow.",
        "height": 800,
        "width": 480
      }
    },
    {
      "id": "g0",
      "name": "Sticky Note g0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -96,
        160
      ],
      "parameters": {
        "content": "## Fetch the feed on schedule\n\nThe schedule trigger runs once a day and the RSS node pulls the current feed contents.",
        "height": 288,
        "width": 672,
        "color": 7
      }
    },
    {
      "id": "g1",
      "name": "Sticky Note g1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        864,
        96
      ],
      "parameters": {
        "content": "## Keep only what is new\n\nWithout this filter the same items would be reposted every morning, because the feed returns its full window each time.",
        "height": 368,
        "width": 240,
        "color": 7
      }
    },
    {
      "id": "g2",
      "name": "Sticky Note g2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "content": "## Format and merge items\n\nAggregate is what turns twenty separate notifications into one digest.",
        "height": 272,
        "width": 672,
        "color": 7
      }
    },
    {
      "id": "g3",
      "name": "Sticky Note g3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2304,
        160
      ],
      "parameters": {
        "content": "## Post to Slack\n\nA single message lands in the channel.",
        "height": 288,
        "width": 240,
        "color": 7
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "9d011450-0290-4898-9396-79e37358bb52",
      "name": "Every Morning at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/frontpage",
        "options": {}
      },
      "id": "b0beb580-aa05-449d-a380-6451965fa0a4",
      "name": "Fetch RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "65f99c21-fd49-4b62-a23e-3da5fecb36a6",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "leftValue": "={{ $json.isoDate }}",
              "rightValue": "={{ $now.minus(1, 'day').toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "96d7aa76-18c9-4087-9e2f-c4c8466411e7",
      "name": "Filter Items From Last 24h",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "8edfd29a-4584-46bc-8afc-7625d9ff590f",
              "name": "line",
              "value": "=• <{{ $json.link }}|{{ $json.title }}>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "3940e285-41fd-4e30-bd68-529a28cf05a8",
      "name": "Build Digest Lines",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "a6eb3b43-fd4a-46c9-ace4-63dd79b3b290",
      "name": "Merge Into One Message",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1880,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#digest"
        },
        "text": "=*Daily digest*\n{{ $json.data.map(i => i.line).join('\\n') }}",
        "otherOptions": {}
      },
      "id": "dc258ebf-0ac3-427a-8802-dab06c767746",
      "name": "Post Digest to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        2360,
        300
      ],
      "credentials": {
        "slackApi": {
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Every Morning at 8am": {
      "main": [
        [
          {
            "node": "Fetch RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS Feed": {
      "main": [
        [
          {
            "node": "Filter Items From Last 24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Items From Last 24h": {
      "main": [
        [
          {
            "node": "Build Digest Lines",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest Lines": {
      "main": [
        [
          {
            "node": "Merge Into One Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Into One Message": {
      "main": [
        [
          {
            "node": "Post Digest to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
